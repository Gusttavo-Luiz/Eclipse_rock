# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Obrigatório em produção: segredo aleatório com 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Porta HTTP do servidor
PORT=3001

# Pasta persistente com o banco SQLite e as imagens enviadas.
# Em produção, aponte para um volume/disco persistente.
DATA_DIR=./data

# URL pública do site (canonical, sitemap, Open Graph). Se definida, tem prioridade
# sobre o campo "Endereço do site" do painel.
SITE_URL=https://eclipserock.com.br

# Atrás de proxy reverso/plataforma (Render, Railway, Fly, Nginx): número de proxies confiáveis.
TRUST_PROXY=1

# Origens extras aceitas em requisições do painel (separadas por vírgula). Normalmente vazio.
ALLOWED_ORIGINS=

# Duração da sessão do painel, em dias
SESSION_DAYS=7

# Tamanho máximo de upload de imagem (MB)
MAX_UPLOAD_MB=10
