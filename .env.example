# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Obrigatório em produção: segredo aleatório com 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Porta HTTP do servidor
PORT=3001

# Pasta persistente com o banco SQLite e as imagens enviadas.
# Em produção, aponte para um volume/disco persistente.
DATA_DIR=./data

# URL pública do site (canonical, sitemap, Open Graph, links dos e-mails). Se definida, tem prioridade
# sobre o campo "Endereço do site" do painel. No Render, se vazia, usa o endereço .onrender.com.
SITE_URL=https://eclipserock.com.br

# Primeiro administrador sem terminal: enquanto ninguém consegue entrar no painel, o servidor cria
# esta conta e envia um convite por e-mail ao subir (exige o envio de e-mail configurado abaixo).
ADMIN_EMAIL=
ADMIN_NAME=

# Atrás de proxy reverso/plataforma (Render, Railway, Fly, Nginx): número de proxies confiáveis.
TRUST_PROXY=1

# Origens extras aceitas em requisições do painel (separadas por vírgula). Normalmente vazio.
ALLOWED_ORIGINS=

# Duração da sessão do painel, em dias
SESSION_DAYS=7

# Tamanho máximo de upload de imagem (MB)
MAX_UPLOAD_MB=10

# ---------- Aviso por e-mail de novas solicitações de contratação ----------
# Sem MAIL_FROM + um provedor, nada é enviado (as solicitações continuam no painel).
# Os destinatários são definidos no painel, em Configurações → Avisos de novas solicitações.
#
# Remetente. O domínio precisa estar verificado no provedor.
MAIL_FROM=
#
# Opção 1 (recomendada): Resend — https://resend.com (plano gratuito atende o volume de uma banda)
RESEND_API_KEY=
#
# Opção 2: SMTP (Google Workspace/Gmail com senha de app, Zoho, Brevo, provedor de hospedagem…)
# Usado apenas se RESEND_API_KEY estiver vazio. Porta 465 = TLS direto; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true
